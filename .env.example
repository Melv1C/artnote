# Environment Configuration
# Copy this file to .env and fill in the values (see src/lib/env.ts)

# Vercel Environment
VERCEL_ENV="development"

# Public base URL of the app (Better Auth base URL and absolute Open Graph URLs)
BASE_URL="http://localhost:3000"

# Prisma Accelerate connection string
PRISMA_DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=your_api_key"

# Better Auth
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"

# Vercel Blob (image and avatar uploads)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Secret expected by the /api/cron/* endpoints (Vercel sends it as a Bearer token)
CRON_SECRET="change-me-at-least-16-chars"
