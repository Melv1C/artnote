# Environment Configuration
# `bun run db:setup` copies this file to .env with a database, port and secrets of its own (see src/lib/env.ts)

# Public base URL of the app (Better Auth base URL and absolute Open Graph URLs). The dev server listens on its port.
BASE_URL="http://localhost:3000"

# Database. The default points at the local Docker Postgres (`bun run db:setup`).
PRISMA_DATABASE_URL="postgresql://artnote:artnote@localhost:5432/artnote"

# Better Auth
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"

# Object storage for image and avatar uploads: the local MinIO of compose.yaml (`bun run db:setup`).
# All five or none. Every checkout shares the `artnote` bucket.
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="artnote"
S3_ACCESS_KEY_ID="artnote"
S3_SECRET_ACCESS_KEY="artnote-dev-storage"
S3_PUBLIC_URL="http://localhost:9000/artnote"

# Header holding the visitor's IP for the view count, set by the reverse proxy (x-real-ip on
# Dokploy). Leave unset locally: without a proxy any client could send it, and views are not counted.
# CLIENT_IP_HEADER="x-real-ip"

# Secret expected by the /api/cron/* endpoints (the scheduled job sends it as a Bearer token)
CRON_SECRET="change-me-at-least-16-chars"
