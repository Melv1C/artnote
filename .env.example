# Environment Configuration
# Copy this file to .env and fill in the values (see src/lib/env.ts)

# Vercel Environment
VERCEL_ENV="development"

# Public base URL of the app (Better Auth base URL and absolute Open Graph URLs)
BASE_URL="http://localhost:3000"

# Database. The default points at the local Docker Postgres (`bun run db:setup`).
# A prisma+postgres:// Accelerate URL (what Vercel uses) also works.
PRISMA_DATABASE_URL="postgresql://artnote:artnote@localhost:5432/artnote"

# Better Auth
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"

# Vercel Blob (image and avatar uploads). Uploads fail locally without a real token.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Secret expected by the /api/cron/* endpoints (Vercel sends it as a Bearer token)
CRON_SECRET="change-me-at-least-16-chars"
