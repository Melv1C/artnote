{
  "name": "artnote",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "vpx scripts/preflight.ts dev && vp dev",
    "build": "vp build",
    "start": "node .output/server/index.mjs",
    "preview": "vp preview",
    "check": "vpx scripts/preflight.ts check && prisma generate && prisma validate && prisma format --check && vp check && vp test && knip && vp build",
    "fix": "vp check --fix",
    "test:e2e": "playwright test",
    "worktree:setup": "vpx scripts/worktree-setup.ts",
    "db:seed": "prisma db seed",
    "db:reset": "vpx scripts/worktree-setup.ts --reset",
    "db:down": "docker compose down",
    "prisma:migrate": "prisma migrate dev",
    "prepare": "vp config"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
