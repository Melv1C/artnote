{
  "$schema": "https://t3.codes/schema/t3.json",
  "iconPath": "public/icon.png",
  "defaultThreadEnvMode": "worktree",
  "scripts": [
    {
      "name": "Setup worktree",
      "command": "vp install && vp run worktree:setup",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Dev",
      "command": "vp run dev",
      "icon": "play",
      "stopOnSettle": true
    },
    {
      "name": "Check",
      "command": "vp run check",
      "icon": "test"
    },
    {
      "name": "E2E",
      "command": "vp run test:e2e",
      "icon": "test"
    }
  ]
}
